; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="三教杯demo"
run/main_scene="res://main_menu.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.png"

[autoload]

SceneFade="*res://scene_fade.gd"
PlayerState="*res://player_state.gd"
StudyProgress="*res://study_progress.gd"
SaveManager="*res://save_manager.gd"
StatRewards="*res://stat_rewards.gd"
LocalDialogue="*res://local_dialogue.gd"

[display]

window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://fonts/StoryFont.tres"

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
