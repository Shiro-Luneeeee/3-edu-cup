[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://lobby.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://images/阳光下的考试桌面.png" id="2_background"]
[ext_resource type="AudioStreamMP3" path="res://audio/music/Mateus Asato - Kawaii.mp3" id="3_music"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.08, 0.13, 0.24, 0.9)
corner_radius_top_left = 20
corner_radius_top_right = 20
corner_radius_bottom_right = 20
corner_radius_bottom_left = 20
shadow_color = Color(0, 0, 0, 0.32)
shadow_size = 18

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2_background")
expand_mode = 1
stretch_mode = 6

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.05, 0.07, 0.14, 0.45)

[node name="LobbyMusic" type="AudioStreamPlayer" parent="."]
stream = ExtResource("3_music")
volume_db = -8.0

[node name="LobbyPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -350.0
offset_top = -280.0
offset_right = 350.0
offset_bottom = 280.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("PanelStyle")

[node name="Margin" type="MarginContainer" parent="LobbyPanel"]
layout_mode = 2
theme_override_constants/margin_left = 36
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 36
theme_override_constants/margin_bottom = 30

[node name="Column" type="VBoxContainer" parent="LobbyPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="LobbyPanel/Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.97, 0.88, 1)
theme_override_font_sizes/font_size = 42
text = "牌局准备"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="LobbyPanel/Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.87, 1, 1)
theme_override_font_sizes/font_size = 18
text = "这一局，从你的第一张牌开始。"
horizontal_alignment = 1

[node name="MatchInfo" type="Label" parent="LobbyPanel/Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.93, 0.97, 1)
theme_override_font_sizes/font_size = 18
text = "目标：取得 100 点学习进度\n初始体力：20   ·   每回合能量：3\n点击手牌，再点击桌上的卡槽使用它。"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="LobbyPanel/Margin/Column"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
mouse_filter = 2

[node name="StartButton" type="Button" parent="LobbyPanel/Margin/Column"]
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "进入牌局"

[node name="CardsButton" type="Button" parent="LobbyPanel/Margin/Column"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "卡牌一览"

[node name="RulesButton" type="Button" parent="LobbyPanel/Margin/Column"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "玩法说明"

[node name="BackButton" type="Button" parent="LobbyPanel/Margin/Column"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "返回卧室"

[node name="CardsDialog" type="AcceptDialog" parent="."]
title = "卡牌一览"
dialog_text = "每种卡牌在初始牌库中有 3 张。\n\n0 费：预习、解题、深呼吸\n1 费：认真听讲、课间休息、合作\n2 费：熬夜突击、押题、调整心态\n3 费：通宵\n\n进入牌局后会从牌库中随机抽取手牌。"
ok_button_text = "知道了"

[node name="RulesDialog" type="AcceptDialog" parent="."]
title = "玩法说明"
dialog_text = "每回合有 3 点能量，打出卡牌会消耗对应能量。\n点击手牌，再点击高亮的卡槽出牌。\n每个卡槽每回合只能使用一次。\n按空格结束回合，从第二回合起，每回合开始抽两张牌。\n进度达到 100 可提前结算，第五回合结束时自动结算。\n结算后进入下一轮，精力回满。"
ok_button_text = "知道了"
