[node name="Center" type="CenterContainer" parent="ListView"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="ListView/Center"]
unique_name_in_owner = true
layout_mode = 2
