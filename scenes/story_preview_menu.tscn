[node name="Content" type="VBoxContainer" parent="ListView/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="ListView/Center/Panel/Content"]
layout_mode = 2

[node name="Title" type="Label" parent="ListView/Center/Panel/Content/Header"]
