extends "res://story_dialogue.gd"

const SocialCharacters := preload("res://social_characters.gd")
const BACKGROUNDS := {
	"hallway": "res://images/fushimi_confession/hallway.png",
	"exam": "res://images/fushimi_confession/exam.png",
	"listening": "res://images/fushimi_confession/listening.png",
	"smile": "res://images/fushimi_confession/smile.png",
	"surprised": "res://images/fushimi_confession/surprised.png",
	"path": "res://images/fushimi_confession/path.png",
	"holding_hands": "res://images/fushimi_confession/holding_hands.png",
}
const LINES := [
	{"text": "深秋的傍晚总是来得格外早，教学楼的走廊里已经亮起了白炽灯，将窗外沉沉的暮色隔绝开来。", "background": "hallway"},
	{"text": "我拎着书包，放轻脚步走过空荡荡的楼梯间，朝着高一A班的教室走去——午休去找伏见宫时，我把物理练习册忘在了那儿。本以为这会儿教室里早就空无一人，可当我透过后门的玻璃往里看时，却意外地顿住了脚步。"},
	{"text": "靠窗的第二排座位上，伏见宫夜姬正一个人安静地坐在那里。", "background": "exam"},
	{"text": "升入高中后，她依旧是那个全年级瞩目的完美优等生，无论是学生会的工作还是每次大考的榜单，她的名字永远稳稳地挂在最顶端。可此刻，夕阳最后的余晖落在她微微低垂的侧脸上，竟透出几分罕见的疲惫与落寞。"},
	{"text": "她的面前摊开着今天刚发下来的月考数学试卷，那张向来接近满分的卷面上，这次却在最后一道压轴题的位置，刺眼地划着一道红色的叉号。"},
	{"text": "虽然总分依旧高居年级第二，可对向来对自己严苛到极致的她而言，这大概算得上是一次不小的“失利”吧。"},
	{"text": "我轻轻推开教室后门，走了过去。"},
	{"speaker": "player", "text": "伏见宫同学，天都快黑了，怎么还不回家？"},
	{"text": "听到声音，伏见宫的肩膀微微一颤，下意识地伸手将试卷往课本下面压了压，随后才抬起头。当看清来人是我时，她紧绷的眉眼稍微放松了些，习惯性地想要摆出那副端庄得体的微笑，可嘴角刚扬起一点，便又有些无力地落了回去。"},
	{"speaker": "fushimi", "text": "是 /name 同学啊……我只是在整理一下错题，马上就走了。倒是你，怎么又折回来了？"},
	{"speaker": "player", "text": "我来拿落下的练习册。不过……"},
	{"text": "我走到她旁边的空位坐下——升入高中后，我们分到了不同的班级，难得还能像以前那样坐在一起。我目光落在露出半截红叉的卷角上，放轻了声音。"},
	{"speaker": "player", "text": "是在意这次月考的那道压轴题吗？其实第二名已经很厉害了，班上大家都在感叹这次的题简直不是人做的。"},
	{"text": "伏见宫沉默了片刻，纤细的手指无意识地摩挲着笔杆，低垂着眼帘，长长的睫毛在眼睑下投出一片淡淡的阴影。"},
	{"speaker": "fushimi", "text": "并不是因为名次。只是……明明之前复习的时候已经见过类似的题型，考试时却因为一时走神算错了符号。这种低级失误，实在太不应该了。"},
	{"text": "她的声音很轻，没有了平日里作为学生会干部的凌厉与从容，反倒像是一个不小心考砸了、正独自生着闷气的小女孩。"},
	{"text": "看着她这副强撑着完美外壳、却又悄悄跟自己较劲的模样，我的心口忽然像是被什么东西轻轻撞了一下，一股莫名的酸涩与心疼悄然蔓延开来。"},
	{"text": "从小一第一次在教室里被她指着姓名贴局促地站起身，到后来被她捉弄着修了一下午没墨的钢笔、被她留下来一题一题耐心地补习功课，再到初中旧书店里那个只属于我们两个人的童话秘密……"},
	{"text": "不知从什么时候开始，那个总是高高在上、令人敬畏的“冰山班长”，早就一点一点走进了我的心里。我早已不再害怕她的严格，甚至比任何人都更在意她眉宇间那一点点不易察觉的失落。"},
	{"speaker": "player", "text": "那个……伏见宫同学，你还记得小学那会儿，我测验考得一塌糊涂的时候，你是怎么跟我说的吗？"},
	{"text": "伏见宫微微一怔，有些疑惑地抬起头看向我。", "background": "listening"},
	{"text": "我深吸了一口气，压下胸口陡然加快的心跳，努力让自己的语气听起来像当年那样自然，眼神却一眨不眨地迎上她清澈的眸子。"},
	{"speaker": "player", "text": "你当时说，只要静下心来，其实我的反应并不算慢。现在这句话，我也想原封不动地还给你——偶尔失误一次根本不算什么，你在我心里，一直都是最厉害的那个人。"},
	{"text": "空气仿佛在这一刻安静了下来，连窗外风吹树叶的沙沙声都变得清晰可闻。"},
	{"text": "伏见宫愣愣地看着我，那双清冷的眼眸里闪过一丝惊讶，紧接着，一抹淡淡的红晕顺着她白皙的脸颊悄然爬上了耳尖。"},
	{"speaker": "fushimi", "text": "……真是的，连这种陈年旧事都拿出来说教我，/name 同学现在倒是越来越大胆了呢。"},
	{"text": "她轻声嘟囔了一句，虽然嘴上这么说，可原本紧锁的眉头却已经彻底舒展开来，嘴角也终于重新勾起了一抹真实而柔和的笑意。", "background": "smile"},
	{"text": "看着她这副模样，我喉结微微滚动了一下，原本在心里藏了许久、一直找不到合适时机说出口的那句话，顺着此刻温热的晚风，就这样毫无预兆地冲到了嘴边。"},
	{"text": "我双手放在膝盖上微微收紧，直视着她的眼睛，声音虽然带着一丝紧张的微颤，却无比坚定。"},
	{"speaker": "player", "text": "因为我一直在看着你啊。从小学一年级开始，一直到现在……伏见宫夜姬，我喜欢你。"},
	{"text": "话音落下的瞬间，整个教室仿佛被按下了暂停键。"},
	{"text": "伏见宫整个人彻底僵在了原地，握着钢笔的手指微微一松，笔杆落在桌面上，发出一声清脆的轻响。", "background": "surprised", "camera_move": true},
	{"text": "她睁大了眼睛，平日里无论遇到什么突发状况都能冷静应对的优等生，此刻大脑却像是彻底宕机了一般，白皙的脸庞瞬间染上了大片绯红，连呼吸都慢了半拍。"},
	{"speaker": "fushimi", "text": "……你、你刚才……说什么？"},
	{"text": "她的声音细若蚊呐，带着几分难以置信的慌乱，眼神下意识地躲闪了一下，却又在下一秒重新对上了我认真的目光。"},
	{"speaker": "player", "text": "我说，我喜欢你。不是因为你是班长，也不是因为你成绩好，只是喜欢那个会偷偷捉弄人、喜欢看童话书、偶尔也会因为一道题而跟自己较劲的伏见宫夜姬。"},
	{"text": "我一口气把心里话全说了出来，耳根热得发烫，却一步也没有退缩。"},
	{"text": "伏见宫低着头，长发垂落下来遮住了她大半张泛红的脸颊。过了许久，久到我以为时间都要静止时，她才极其轻微地吸了一口气，伸手将耳边的碎发别到耳后，抬起头看向我。"},
	{"text": "夕阳的最后一丝金光刚好落在她眼底，映出一片从未有过的、既羞涩又明亮的光彩，嘴角轻轻弯起一个好看的弧度。", "background": "smile"},
	{"speaker": "fushimi", "text": "……真是犯规啊，/name 同学。趁着别人心情低落的时候突然说出这种话，根本不给人留一点准备的时间。"},
	{"text": "她顿了顿，将桌上的数学试卷整齐地收进书包，随后站起身，微微偏过头，耳尖依旧红得发烫，声音却清晰地传进了我的耳朵里。"},
	{"speaker": "fushimi", "text": "不过……既然你都这么说了，从今天起，可不能再像以前那样随便走神了。请多指教了，/name 君。"},
	{"text": "……/name 君？"},
	{"text": "听到这个称呼的瞬间，我整个人愣在原地，大脑仿佛被一阵突如其来的烟花炸得一片空白，直到她已经背好书包站在过道里，我才猛地回过神来。"},
	{"speaker": "player", "text": "等、等等！刚才那是……答应的意思吗？！"},
	{"text": "我手忙脚乱地从座位上站起来，连差点被椅子腿绊倒都顾不上，眼巴巴地看着她。"},
	{"text": "伏见宫看着我这副呆头呆脑的模样，原本还带着几分羞涩的脸上忍不住漾开了一抹浅浅的笑意。她没有直接回答，而是微微偏过头，看向窗外已经彻底暗下来的夜色。"},
	{"speaker": "fushimi", "text": "怎么，难不成 /name 君以为，我会随便对一个人改口叫名字吗？"},
	{"text": "她的声音依旧清冷悦耳，可尾音里却藏着一丝怎么也掩不住的轻快与纵容。"},
	{"speaker": "player", "text": "不、不是！我只是太高兴了，有点不敢相信……"},
	{"text": "我抓了抓后脑勺，脸颊热得厉害，心里却像是被灌满了温热的蜜糖，整个人轻飘飘的，连呼吸都变得格外顺畅。"},
	{"text": "伏见宫轻轻叹了口气，像是在拿我没办法似的摇了摇头，随后极其自然地朝我伸出手，指尖轻轻碰了碰我空着的衣袖。"},
	{"speaker": "fushimi", "text": "再不走的话，教学楼的大门就要被保安锁上了。走吧，一起回家。"},
	{"speaker": "player", "text": "嗯！一起回家！"},
	{"text": "我连忙抓起书包跟上她的步伐，与她并肩走出教室。"},
	{"text": "走廊里的声控灯随着我们的脚步声一盏接一盏地亮起，暖黄色的灯光将两人的影子拉得很长很长，紧紧地靠在一起。", "background": "hallway"},
	{"text": "下了楼梯，走出教学楼的大门，深秋夜晚的微风迎面吹来，带着几分凉意，却吹不散心头的滚烫。校道两旁的路灯静静地亮着，周围空无一人，安静得只能听见彼此轻微的脚步声。", "background": "path"},
	{"text": "走了没几步，身旁的伏见宫忽然放慢了脚步。"},
	{"text": "我疑惑地侧过头看她，只见她正微微低着头，目光落在我们之间那段短短的距离上，纤细的手指在身侧轻轻蜷了蜷，似乎在犹豫着什么。"},
	{"text": "下一秒，一只微凉却柔软的小手，极其自然地钻进了我的掌心，指尖顺势扣住了我的手指。", "background": "holding_hands"},
	{"text": "我的心跳瞬间漏了一拍，下意识地收紧手掌，将她的手牢牢握住。"},
	{"text": "伏见宫的耳尖在路灯的映照下泛起一抹诱人的绯红，她没有抽回手，只是目不斜视地盯着前方的校门，嘴角却轻轻扬起一个温柔到极致的弧度，小声嘟囔了一句。"},
	{"speaker": "fushimi", "text": "真奇怪……明明刚才还觉得心里空落落的，现在却一点也不在意那道压轴题了。"},
	{"speaker": "player", "text": "那以后每次考试前，我都陪你一起复习怎么样？虽然我可能帮不上什么大忙……"},
	{"speaker": "fushimi", "text": "嗯，那就说定了。不过要是你敢在复习的时候偷懒，惩罚可是会比小学时候还要严厉的。"},
	{"text": "她侧过头看向我，夜风轻轻拂起她耳边的发丝，那双清澈如星辰的眼眸里，此刻满满当当只映着我一个人的身影。"},
	{"text": "我握紧了手中那份真实的温度，看着眼前这位终于卸下所有防备、只属于我一个人的少女，忍不住在晚风里笑出了声。"},
	{"speaker": "player", "text": "求之不得，伏见宫同学——不，夜姬。"},
	{"text": "她微微一怔，随后眼底的笑意更深了几分，轻轻“嗯”了一声，与我十指相扣，并肩走出了寂静的校园。"},
]


func lines() -> Array:
	return LINES


func final_button_text() -> String:
	return "查看专属卡  ›"


func stage_line(line: Dictionary) -> String:
	if line.has("background"):
		show_background(load(BACKGROUNDS[line["background"]]) as Texture2D)
	if line.get("camera_move", false):
		shake_stage(0.28)
	match line.get("speaker", ""):
		"player": return PlayerState.player_name
		"fushimi": return SocialCharacters.FUSHIMI
	return ""
