[resource]
script = ExtResource("1_script")
id = "pale_myth_heart_sky"
title = "苍白神话：心空"
description = "一部东方神话动作冒险。相传天穹曾有一颗心，如今只剩无声的空白。你将循着古老神祇遗落的低语，行过雾海与荒祠，迎战守护旧约的异灵，拾回散落的心火，探寻苍白神话的来处。"
short_description = "天穹失心，旧神沉默。穿行雾海与荒祠，寻回散落的心火。"
energy_cost = 5
effect_description = "智力 +10"
price = 180
reward_stat = "intelligence"
play_story = "你循着微弱的心火走过雾海，在荒祠里读懂一段被遗忘的神话。谜题曾让你停下来想了很久，线索拼合的瞬间，眼前的故事也豁然开朗。关掉游戏后，你还在回味那片苍白天空下的秘密。"
cover = ExtResource("2_cover")
